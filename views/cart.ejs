<%- include('partials/navbar') %>
<div class="container cart-container">
  <h2 class="cart-title">🛒 Your Cart</h2>
  <% if (cart.length === 0) { %>
    <div class="alert alert-info cart-empty">Your cart is empty.</div>
    <a href="/products" class="btn btn-primary">Continue Shopping</a>
  <% } else { %>
    <div class="cart-table-wrapper">
      <table class="table cart-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Image</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% cart.forEach(item => { %>
            <tr>
              <td><strong><%= item.name %></strong></td>
              <td>
                <% if (item.image) { %>
                  <img src="/images/<%= item.image %>" alt="<%= item.name %>" class="cart-img-thumb" />
                <% } else { %>
                  <span class="cart-img-placeholder">No Image</span>
                <% } %>
              </td>
              <td><%= item.quantity %></td>
              <td>$<%= item.price.toFixed(2) %></td>
              <td>$<%= (item.price * item.quantity).toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="cart-total-box">
      <strong>Total: $<%= total.toFixed(2) %></strong>
    </div>
    <a href="/checkout" class="btn btn-success cart-checkout-btn">Proceed to Checkout</a>
  <% } %>
</div>
<%- include('partials/footer') %>
