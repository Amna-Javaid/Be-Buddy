
<h1 style="text-align:center; margin-bottom:2rem;">Edit Product</h1>
<form class="admin-form" action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" value="<%= product.name %>" required>

    <label for="price">Price</label>
    <input type="number" id="price" name="price" step="0.01" value="<%= product.price %>" required>

    <label for="description">Description</label>
    <textarea id="description" name="description" rows="3" required><%= product.description %></textarea>

    <label for="image">Product Image</label>
    <input type="file" id="image" name="image" accept="image/*">
    <% if (product.image) { %>
        <div style="margin: 10px 0;">
            <img src="/images/<%= product.image %>" alt="Current Image" style="max-width: 120px; max-height: 120px;">
        </div>
    <% } %>

    <label for="category">Category</label>
    <select id="category" name="category" required>
        <option value="">Select Category</option>
        <option value="Makeup" <%= product.category === 'Makeup' ? 'selected' : '' %>>Makeup</option>
        <option value="Eye Makeup" <%= product.category === 'Eye Makeup' ? 'selected' : '' %>>Eye Makeup</option>
        <option value="Beauty Tools" <%= product.category === 'Beauty Tools' ? 'selected' : '' %>>Beauty Tools</option>
    </select>

    <button type="submit">Update Product</button>
</form>

