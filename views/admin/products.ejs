
<h1 style="text-align:center; margin-bottom:2rem;">Product List</h1>
<div style="overflow-x:auto;">
<table class="admin-table" style="width:100%; border-collapse:collapse;">
    <thead style="background:#f5f5f5;">
        <tr>
            <th style="padding:10px; border-bottom:2px solid #ddd;">Image</th>
            <th style="padding:10px; border-bottom:2px solid #ddd;">Name</th>
            <th style="padding:10px; border-bottom:2px solid #ddd;">Price</th>
            <th style="padding:10px; border-bottom:2px solid #ddd;">Category</th>
            <th style="padding:10px; border-bottom:2px solid #ddd;">Actions</th>
        </tr>
    </thead>
    <tbody>
        <% products.forEach(function(product) { %>
        <tr>
            <td style="text-align:center; padding:8px;">
                <% if (product.image) { %>
                    <img src="/images/<%= product.image %>" alt="<%= product.name %>" style="max-width:60px; max-height:60px; border-radius:6px;">
                <% } else { %>
                    <span style="color:#aaa;">No Image</span>
                <% } %>
            </td>
            <td style="padding:8px;"><%= product.name %></td>
            <td style="padding:8px;">$<%= product.price %></td>
            <td style="padding:8px;"><%= product.category %></td>
            <td style="padding:8px;">
                <a href="/admin/products/edit/<%= product._id %>" style="background:#4CAF50; color:#fff; padding:6px 12px; border-radius:4px; text-decoration:none; margin-right:6px;">Edit</a>
                <form action="/admin/products/delete/<%= product._id %>" method="POST" style="display:inline;">
                    <button type="submit" style="background:#f44336; color:#fff; border:none; padding:6px 12px; border-radius:4px; cursor:pointer;">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>
</div>
<div style="text-align:right; margin-top:1.5rem;">
    <a href="/admin/products/add" style="background:#2196F3; color:#fff; padding:10px 18px; border-radius:4px; text-decoration:none;">Add New Product</a>
</div>
