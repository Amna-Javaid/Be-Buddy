<%- include('partials/navbar') %>
<div class="container order-confirm-container">
  <div class="order-confirm-box">
    <h2 class="order-confirm-title">✅ Order Confirmation</h2>
    <div class="alert alert-success order-confirm-alert">
      <p>Thank you for your order, <strong><%= order.customerName %></strong>!</p>
      <p>Your Order ID: <strong><%= order._id %></strong></p>
      <p>Total Amount: <strong>$<%= order.totalAmount.toFixed(2) %></strong></p>
      <p>Status: <strong><%= order.status %></strong></p>
      <p>Order placed on: <%= order.createdAt.toLocaleString() %></p>
    </div>
    <h4 class="order-items-title">Order Items</h4>
    <ul class="list-group mb-3 order-items-list">
      <% order.cartItems.forEach(item => { %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <span>Product ID: <%= item.product %> (x<%= item.quantity %>)</span>
          <span>$<%= (item.price * item.quantity).toFixed(2) %></span>
        </li>
      <% }) %>
    </ul>
    <a href="/products" class="btn btn-primary order-confirm-btn">Continue Shopping</a>
  </div>
</div>
<%- include('partials/footer') %>
